# ─────────────────────────────────────────────────────────────
# VK Events — Environment Variables
# ─────────────────────────────────────────────────────────────

# Cloudinary Configuration
# Option 1: Individual API credentials (from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option 2: Full connection URL (alternative to Option 1)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Folder where images will be organized in Cloudinary
CLOUDINARY_FOLDER=vk-events

# Server Port (default 3000)
PORT=3000
